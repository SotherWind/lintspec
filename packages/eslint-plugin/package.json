{
  "name": "@lintspec/eslint-plugin",
  "version": "1.0.0",
  "description": "Custom ESLint rules used by lintspec: no-http-url, no-secret-info, no-broad-semantic-versioning, no-js-in-ts-project.",
  "author": "SotherWind",
  "license": "MIT",
  "homepage": "https://github.com/SotherWind/lintspec/tree/main/packages/eslint-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/SotherWind/lintspec.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/SotherWind/lintspec/issues"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "lintspec"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc -w",
    "test": "vitest run"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "eslint": "^10.14.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
