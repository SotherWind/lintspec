{
  "name": "lintspec",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend linting & coding-style specification (ESLint / Stylelint / commitlint / markdownlint / Prettier) as a unified toolchain",
  "author": "SotherWind",
  "license": "MIT",
  "homepage": "https://github.com/SotherWind/lintspec",
  "repository": {
    "type": "git",
    "url": "https://github.com/SotherWind/lintspec.git"
  },
  "bugs": {
    "url": "https://github.com/SotherWind/lintspec/issues"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "pnpm run lint:md && pnpm run lint:js",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\" \"#**/dist\"",
    "lint:js": "eslint .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish",
    "postinstall": "pnpm -r --filter @lintspec/markdownlint-config --filter @lintspec/commitlint-config --filter @lintspec/eslint-config build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/lint": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@lintspec/commitlint-config": "workspace:*",
    "@lintspec/eslint-config": "workspace:*",
    "@lintspec/markdownlint-config": "workspace:*",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^5.1.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-plugin-n": "^18.5.0",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  }
}
