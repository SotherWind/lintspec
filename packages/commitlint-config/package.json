{
  "name": "@lintspec/commitlint-config",
  "version": "1.0.0",
  "description": "Shareable commitlint config used by lintspec — conventional-commits based.",
  "author": "SotherWind",
  "license": "MIT",
  "homepage": "https://github.com/SotherWind/lintspec/tree/main/packages/commitlint-config",
  "repository": {
    "type": "git",
    "url": "https://github.com/SotherWind/lintspec.git",
    "directory": "packages/commitlint-config"
  },
  "bugs": {
    "url": "https://github.com/SotherWind/lintspec/issues"
  },
  "keywords": [
    "commitlint",
    "commitlint-config",
    "conventional-commits",
    "lintspec"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc -w",
    "test": "vitest run"
  },
  "dependencies": {
    "conventional-changelog-conventionalcommits": "^10.4.1"
  },
  "devDependencies": {
    "@commitlint/lint": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
