{
  "name": "lintspec",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend linting & coding-style specification (ESLint / Stylelint / commitlint / markdownlint / Prettier) as a unified toolchain",
  "author": "SotherWind",
  "license": "MIT",
  "homepage": "https://github.com/SotherWind/lintspec",
  "repository": {
    "type": "git",
    "url": "https://github.com/SotherWind/lintspec.git"
  },
  "bugs": {
    "url": "https://github.com/SotherWind/lintspec/issues"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@lintspec/eslint-config": "workspace:*",
    "husky": "^9.1.6",
    "markdownlint-cli2": "^0.14.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.2"
  }
}
