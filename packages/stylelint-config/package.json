{
  "name": "@lintspec/stylelint-config",
  "version": "1.0.0",
  "description": "Shareable Stylelint config (CSS / SCSS / Less) used by lintspec.",
  "author": "SotherWind",
  "license": "MIT",
  "homepage": "https://github.com/SotherWind/lintspec/tree/main/packages/stylelint-config",
  "repository": {
    "type": "git",
    "url": "https://github.com/SotherWind/lintspec.git",
    "directory": "packages/stylelint-config"
  },
  "bugs": {
    "url": "https://github.com/SotherWind/lintspec/issues"
  },
  "keywords": [
    "stylelint",
    "stylelint-config",
    "scss",
    "less",
    "lintspec"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc -w",
    "test": "vitest run"
  },
  "dependencies": {
    "@stylistic/stylelint-plugin": "^5.3.1",
    "postcss-less": "^7.0.1",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-scss": "^7.4.0"
  },
  "peerDependencies": {
    "stylelint": "^17.6.0"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "stylelint": "^17.16.0",
    "typescript": "^6.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
