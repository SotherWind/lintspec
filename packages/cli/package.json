{
  "name": "@lintspec/cli",
  "version": "1.0.0",
  "description": "One-command lint toolchain (ESLint / Stylelint / markdownlint / Prettier / commitlint) for the lintspec spec.",
  "type": "module",
  "author": "SotherWind",
  "license": "MIT",
  "homepage": "https://github.com/SotherWind/lintspec/tree/main/packages/cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/SotherWind/lintspec.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/SotherWind/lintspec/issues"
  },
  "keywords": [
    "lint",
    "cli",
    "eslint",
    "stylelint",
    "prettier",
    "lintspec"
  ],
  "bin": {
    "lintspec": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc && node scripts/copy-templates.mjs",
    "dev": "tsc -w",
    "pretest": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.4",
    "@inquirer/prompts": "^8.7.5",
    "@lintspec/commitlint-config": "workspace:^",
    "@lintspec/eslint-config": "workspace:^",
    "@lintspec/markdownlint-config": "workspace:^",
    "@lintspec/stylelint-config": "workspace:^",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "ejs": "^7.0.2",
    "eslint": "^10.14.0",
    "execa": "^10.2.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "is-docker": "^4.0.0",
    "markdownlint": "^0.42.0",
    "markdownlint-cli2": "^0.24.0",
    "ora": "^10.0.0",
    "prettier": "^3.9.10",
    "strip-ansi": "^7.2.0",
    "stylelint": "^17.16.0",
    "terminal-link": "^5.0.0",
    "text-table": "^0.2.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.7.0",
    "@types/text-table": "^0.2.5",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
