{
  "name": "@lintspec/eslint-config",
  "version": "1.0.0",
  "description": "Shareable ESLint 9 flat-config presets used by lintspec (JS/TS x React/Vue/Node + essential softened variants).",
  "author": "SotherWind",
  "license": "MIT",
  "homepage": "https://github.com/SotherWind/lintspec/tree/main/packages/eslint-config",
  "repository": {
    "type": "git",
    "url": "https://github.com/SotherWind/lintspec.git",
    "directory": "packages/eslint-config"
  },
  "bugs": {
    "url": "https://github.com/SotherWind/lintspec/issues"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "flat-config",
    "lintspec"
  ],
  "type": "module",
  "main": "./dist/configs/base.js",
  "types": "./dist/configs/base.d.ts",
  "exports": {
    ".": "./dist/configs/base.js",
    "./es5": "./dist/configs/es5.js",
    "./react": "./dist/configs/react.js",
    "./vue": "./dist/configs/vue.js",
    "./node": "./dist/configs/node.js",
    "./jsx-a11y": "./dist/configs/jsx-a11y.js",
    "./typescript": "./dist/configs/typescript/index.js",
    "./typescript/react": "./dist/configs/typescript/react.js",
    "./typescript/vue": "./dist/configs/typescript/vue.js",
    "./typescript/node": "./dist/configs/typescript/node.js",
    "./essential": "./dist/configs/essential/index.js",
    "./essential/es5": "./dist/configs/essential/es5.js",
    "./essential/react": "./dist/configs/essential/react.js",
    "./essential/vue": "./dist/configs/essential/vue.js",
    "./essential/typescript": "./dist/configs/essential/typescript/index.js",
    "./essential/typescript/react": "./dist/configs/essential/typescript/react.js",
    "./essential/typescript/vue": "./dist/configs/essential/typescript/vue.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc -w",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "^9.39.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.14.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-n": "^17.10.3 || ^18.0.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-vue": "^9.28.0 || ^10.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.8.1",
    "vue-eslint-parser": "^9.4.3 || ^10.3.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-n": {
      "optional": true
    },
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-vue": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    },
    "vue-eslint-parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
